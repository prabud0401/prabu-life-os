# Copy to .env — never commit .env

# Notion
NOTION_TOKEN=

# Local dev (optional — uses ~/.blueocean-mcp/ when unset)
AZURE_KEYVAULT_URL=https://kv-bluocn-cstmr-prod.vault.azure.net/

# Railway / cloud (set these instead of Key Vault on Railway)
DATABASE_URL=
MCP_MODE=stdio
PORT=3000
PRABU_MCP_API_KEY=
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://YOUR-APP.up.railway.app/auth/microsoft/callback

# Security / JWT
JWT_SECRET=

# Gmail (optional custom path; defaults to ~/.gmail-mcp/credentials.json)
GMAIL_CREDENTIALS_PATH=
GMAIL_OAUTH_KEYS_PATH=

# PM Tool MCP Proxy
PM_TOOL_BASE_URL=https://pm.blueoceansp.ai/api
PM_MCP_TOKEN=
